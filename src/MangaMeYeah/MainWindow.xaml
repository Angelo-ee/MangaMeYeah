<Window x:Class="MangaMeYeah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MangaMeYeah!"
        Icon="pack://application:,,,/Assets/MangaMeYeah.ico"
        Width="1120"
        Height="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <!-- メインビューア領域 (通常時は上部メニューバー分 Margin="0,20,0,0"、フルスクリーン時は Margin="0" で画面全体を使用しメニューがオーバーレイでプルダウン) -->
        <Grid x:Name="ViewerRootGrid"
              Margin="0,22,0,0"
              Background="#808080"
              ClipToBounds="True"
              Focusable="True"
              SizeChanged="ViewerRootGrid_SizeChanged"
              MouseDown="ViewerRootGrid_MouseDown"
              MouseMove="ViewerRootGrid_MouseMove"
              MouseUp="ViewerRootGrid_MouseUp"
              PreviewMouseWheel="ViewerRootGrid_PreviewMouseWheel">

            <!-- 右クリックコンテキストメニュー (MangaMeeya Resource ID: 295 完全再現) -->
            <Grid.ContextMenu>
                <ContextMenu x:Name="ViewerContextMenu">
                <MenuItem Uid="CTX_143" Header="下一页" Tag="下一页" Click="MenuItem_Click" />
                <MenuItem Uid="CTX_149" Header="上一页" Tag="上一页" Click="MenuItem_Click" />
                <Separator />
                <MenuItem Uid="CTX_167" Header="放大" Tag="放大" Click="MenuItem_Click" />
                <MenuItem Uid="CTX_168" Header="缩小" Tag="缩小" Click="MenuItem_Click" />
                <Separator />
                <MenuItem Header="跳转(_J)">
                    <MenuItem Uid="CTX_143" Header="下一页" Tag="下一页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_144" Header="前进 1 页" Tag="前进 1 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_145" Header="前进 10 页" Tag="前进 10 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_146" Header="前进 20 页" Tag="前进 20 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_147" Header="前进 50 页" Tag="前进 50 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_148" Header="跳到最后一页" Tag="跳到最后一页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_190" Header="下一个子文件夹" Tag="下一个子文件夹" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_188" Header="下一个文件夹(压缩包)" Tag="下一个文件夹(压缩包)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_149" Header="上一页" Tag="上一页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_150" Header="后退 1 页" Tag="后退 1 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_151" Header="后退 10 页" Tag="后退 10 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_152" Header="后退 20 页" Tag="后退 20 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_153" Header="后退 50 页" Tag="后退 50 页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_154" Header="跳到第一页" Tag="跳到第一页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_191" Header="上一个子文件夹" Tag="上一个子文件夹" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_189" Header="上一个文件夹(压缩包)" Tag="上一个文件夹(压缩包)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_272" Header="返回上级文件夹(封面缩略图)" Tag="返回上级文件夹(封面缩略图)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_155" Header="跳转到指定页" Tag="跳转到指定页" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_160" Header="文件视图" Tag="文件视图" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40310" Header="跳到创作者首位(_H)" InputGestureText="Ctrl+Home" Tag="跳到创作者首位" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40311" Header="跳到创作者末位(_E)" InputGestureText="Ctrl+End" Tag="跳到创作者末位" Click="MenuItem_Click" />
                </MenuItem>
                <MenuItem Header="Avisynth 滤镜配置文件(_P)">
                    <MenuItem Uid="CTX_500" Header="profile" Tag="profile" Click="MenuItem_Click" />
                </MenuItem>
                <MenuItem Header="文件(_F)">
                    <MenuItem Uid="CTX_40003" Header="打开" Tag="打开" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_271" Header="打开文件夹" Tag="打开文件夹" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_129" Header="保存" Tag="保存" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_280" Header="关闭" Tag="关闭" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_281" Header="刷新" Tag="刷新" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_218" Header="导入配置文件" Tag="导入配置文件" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_219" Header="导出配置文件" Tag="导出配置文件" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40022" Header="从剪贴板粘贴" Tag="从剪贴板粘贴" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40023" Header="复制到剪贴板" Tag="复制到剪贴板" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40047" Header="页面设置" Tag="页面设置" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40048" Header="打印" Tag="打印" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_127" Header="退出" Tag="退出" Click="ExitMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="视图(_V)">
                    <MenuItem Uid="CTX_40009" Header="单页显示" Tag="单页显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40010" Header="双页显示" Tag="双页显示" Click="MenuItem_Click" />
                    <MenuItem Header="多张·拼接显示(_M)">
                        <MenuItem Uid="CTX_40200" Header="横向 2 张显示 (标准跨页)" Tag="横向 2 张显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40201" Header="纵向 2 张显示" Tag="纵向 2 张显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40202" Header="横向 3 张显示" Tag="横向 3 张显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40203" Header="纵向 3 张显示" Tag="纵向 3 张显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40204" Header="横向 4 张显示" Tag="横向 4 张显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40205" Header="纵向 4 张显示" Tag="纵向 4 张显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40206" Header="2×2 网格显示 (4 张)" Tag="2×2 网格显示" Click="MenuItem_Click" />
                        <Separator />
                        <MenuItem Uid="CTX_40210" Header="拼接图像检测(_C)" Tag="拼接图像检测" Click="MenuItem_Click" IsCheckable="True" />
                    </MenuItem>
                    <MenuItem Header="跨页方向">
                        <MenuItem Uid="CTX_278" Header="左开" Tag="左开" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_279" Header="右开" Tag="右开" Click="MenuItem_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Uid="CTX_131" Header="自动跨页显示" Tag="自动跨页显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_187" Header="自动单页显示(左右分割)" Tag="自动单页显示(左右分割)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_256" Header="自动单页显示(上下分割)" Tag="自动单页显示(上下分割)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40011" Header="缩略图显示(单屏)" Tag="缩略图显示(单屏)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40012" Header="缩略图显示(8 列)" Tag="缩略图显示(8 列)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_232" Header="缩略图显示(自定义)" Tag="缩略图显示(自定义)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_250" Header="封面缩略图" Tag="封面缩略图" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_231" Header="缩略图设置" Tag="缩略图设置" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_119" Header="切换全屏" Tag="全屏" Click="MenuItem_Click" />
                    <MenuItem Header="全屏时的菜单">
                        <MenuItem Uid="CTX_380" Header="固定显示" Tag="固定显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_381" Header="弹出显示" Tag="弹出显示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_382" Header="隐藏" Tag="隐藏" Click="MenuItem_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Uid="CTX_172" Header="放大镜显示" Tag="放大镜显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40031" Header="工具栏显示" Tag="工具栏显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_175" Header="文件夹树显示" Tag="文件夹树显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_195" Header="书单显示" Tag="书单显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_261" Header="书架显示" Tag="书架显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_262" Header="目录显示" Tag="目录显示" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_269" Header="独立窗口显示" Tag="独立窗口显示" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40300" Header="OSD 文本显示(_O)" Tag="OSD 文本显示" Click="MenuItem_Click" IsCheckable="True" />
                    <MenuItem Uid="CTX_40301" Header="显示鼠标手势轨迹(_G)" Tag="显示鼠标手势轨迹" Click="MenuItem_Click" IsCheckable="True" />
                    <MenuItem Uid="CTX_40210" Header="拼接图像检测(_C)" Tag="拼接图像检测" Click="MenuItem_Click" IsCheckable="True" />
                </MenuItem>
                <MenuItem Header="缩放模式(_S)">
                    <MenuItem Uid="CTX_40101" Header="适应宽或高" Tag="适应宽或高" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40102" Header="适应窗口大小" Tag="适应窗口大小" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40103" Header="按原始尺寸显示" Tag="按原始尺寸显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40104" Header="适应图像大小" Tag="适应图像大小" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40106" Header="统一高度(用于双页显示)" Tag="统一高度(用于双页显示)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40105" Header="按指定倍率/尺寸显示" Tag="按指定倍率/尺寸显示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40100" Header="固定倍率(默认)" Tag="固定倍率(默认)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40107" Header="只缩小不放大" Tag="只缩小不放大" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_350" Header="缩放使用 HALFTONE 滤镜(_Z)" Tag="缩放使用 HALFTONE 滤镜" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_351" Header="缩放使用平均像素法(_X)" Tag="缩放使用平均像素法" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_352" Header="缩放使用 Lanczos 滤镜(_C)" Tag="缩放使用 Lanczos 滤镜" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_353" Header="缩放使用三次插值(双三次)(_V)" Tag="缩放使用三次插值(双三次)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_354" Header="缩放使用线性插值(_B)" Tag="缩放使用线性插值" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_355" Header="缩放使用平均像素法+弱锐化(_N)" Tag="缩放使用平均像素法+弱锐化" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_356" Header="缩放使用平均像素法+强锐化(_M)" Tag="缩放使用平均像素法+强锐化" Click="MenuItem_Click" />
                </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 初期ガイド表示 (画像未読込時) -->
            <StackPanel x:Name="EmptyStatePanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="MangaMeYeah!"
                           Foreground="#D8D8D8"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="将图片文件或文件夹拖放到此处，或在资源管理器右键选择「用 MangaMeYeah 打开」"
                           Foreground="#CFCFCF"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="左键: 下一页 ｜ 右键: 上一页 ｜ 右键拖动: 鼠标手势 (↖↗↙↘ 快速保存 1~4 / → 缩略图筛选) ｜ 中键: 放大镜"
                           Foreground="#B8B8B8"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- スクロール＆見開き表示コンテナ -->
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          Focusable="False"
                          PanningMode="Both">
                <Grid x:Name="PageCanvasGrid"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側画像スロット -->
                    <Image x:Name="LeftPageImage"
                           Grid.Column="0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True" />

                    <!-- 右側画像スロット -->
                    <Image x:Name="RightPageImage"
                           Grid.Column="1"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True" />
                </Grid>
            </ScrollViewer>

            <!-- ルーペ (拡大鏡) オーバーレイ -->
            <Canvas x:Name="LoupeOverlayCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border x:Name="LoupeBorder"
                        Width="280"
                        Height="280"
                        BorderBrush="#00FF66"
                        BorderThickness="2"
                        Background="#202020"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" />
                    </Border.Effect>
                    <Canvas ClipToBounds="True">
                        <Rectangle x:Name="LoupeViewportRect" Width="280" Height="280">
                            <Rectangle.Fill>
                                <VisualBrush x:Name="LoupeVisualBrush"
                                             Visual="{Binding ElementName=PageCanvasGrid}"
                                             ViewboxUnits="Absolute"
                                             Stretch="None" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Border>
            </Canvas>

            <!-- マウスジェスチャ軌跡＆コマンド名オーバーレイ -->
            <Canvas x:Name="GestureOverlayCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Polyline x:Name="GestureTrailPolyline"
                          Stroke="#00FF66"
                          StrokeThickness="3"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                <Border x:Name="GestureBadgeBorder"
                        Canvas.Left="24"
                        Canvas.Top="52"
                        Background="#CC181818"
                        BorderBrush="#00FF66"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,6">
                    <TextBlock x:Name="GestureStatusText"
                               Foreground="#00FF66"
                               FontSize="16"
                               FontWeight="Bold" />
                </Border>
            </Canvas>

            <!-- MangaMeeya風 左上ステータスメッセージ OSD -->
            <Border x:Name="OsdStatusBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16,28,0,0"
                    Background="#BF141414"
                    BorderBrush="#4000FF66"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,5"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="OsdStatusText"
                           Foreground="#00FF66"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </Border>

            <!-- サムネイル一覧＆複数選択コレクション画面 (ライトテーブル) -->
            <Grid x:Name="ThumbnailOverlayGrid"
                  Background="#F21E1E1E"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- サムネイル操作＆一括クイックセーブバー -->
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        BorderBrush="#444444"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="ThumbSummaryText"
                                   DockPanel.Dock="Left"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Text="缩略图列表" />

                        <Button Content="全选"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                Click="ThumbSelectAll_Click" />
                        <Button Content="取消选择"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,16,0"
                                Click="ThumbClearSelection_Click" />

                        <TextBlock Text="批量快速保存:"
                                   DockPanel.Dock="Left"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <Button x:Name="BatchQs1Button"
                                Content="保存到 QS1"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                Click="BatchQuickSave1_Click" />
                        <Button x:Name="BatchQs2Button"
                                Content="保存到 QS2"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                Click="BatchQuickSave2_Click" />
                        <Button x:Name="BatchQs3Button"
                                Content="保存到 QS3"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                Click="BatchQuickSave3_Click" />
                        <Button x:Name="BatchQs4Button"
                                Content="保存到 QS4"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,12,0"
                                Click="BatchQuickSave4_Click" />
                        <Button Content="QS 设置..."
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Click="OpenQuickSaveSettings_Click" />

                        <Button Content="关闭 (Esc)"
                                DockPanel.Dock="Right"
                                Padding="12,3"
                                Click="CloseThumbnailView_Click" />

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                            <TextBlock Text="尺寸:"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Slider x:Name="ThumbSizeSlider"
                                    Width="110"
                                    Minimum="100"
                                    Maximum="400"
                                    Value="200"
                                    VerticalAlignment="Center"
                                    ValueChanged="ThumbSizeSlider_ValueChanged" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- サムネイル一覧リスト (行単位仮想化による超高速・省メモリ表示) -->
                <ListBox x:Name="ThumbnailListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding DataContext.ThumbnailCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.ThumbnailCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="6"
                                                CornerRadius="4"
                                                Background="#262626"
                                                BorderThickness="2"
                                                MouseLeftButtonDown="ThumbnailCard_MouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#3E3E42" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#00AAFF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#00FF66" />
                                                            <Setter Property="Background" Value="#1E3A28" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Grid.Row="0"
                                                       Source="{Binding ThumbnailBitmap}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <CheckBox Grid.Row="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"
                                                          Margin="4"
                                                          Click="ThumbnailCheckBox_Click">
                                                    <CheckBox.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                                    </CheckBox.LayoutTransform>
                                                </CheckBox>
                                                <TextBlock Grid.Row="1"
                                                           Foreground="#E0E0E0"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
