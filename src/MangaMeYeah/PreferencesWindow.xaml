<Window x:Class="MangaMeYeah.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="610"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,14,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#F9F9F9" Padding="8">
            <!-- ========================================================= -->
            <!-- タブ 1: 操作設定 (Dialog ID: 1506)                         -->
            <!-- ========================================================= -->
            <TabItem Header="操作设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="缩放">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="缩放变化率" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="ZoomStepTextBox" Width="54" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,28,0" />

                                    <TextBlock Text="当前缩放" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="CurrentScaleTextBox" Width="54" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </WrapPanel>
                                <CheckBox x:Name="ResetScaleOnSameModeCheck"
                                          Content="再次选择同一缩放模式时恢复原始尺寸并切换到固定倍率模式"
                                          Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="移动">
                            <StackPanel>
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="下一页/上一页" VerticalAlignment="Center" />
                                    <TextBox x:Name="StepNextPrevTextBox" Grid.Row="0" Grid.Column="1" Width="54" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="※多张显示时乘以显示张数" Foreground="#555555" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PAGEUP/PAGEDOWN" VerticalAlignment="Center" />
                                    <TextBox x:Name="PageUpDownCountTextBox" Grid.Row="1" Grid.Column="1" Width="54" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="※双页显示时 ×2" Foreground="#555555" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="固定页数翻页" VerticalAlignment="Center" />
                                    <TextBox x:Name="FixedJumpTextBox" Grid.Row="2" Grid.Column="1" Width="54" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="按比例翻页" VerticalAlignment="Center" />
                                    <TextBox x:Name="FixedRatioJumpTextBox" Grid.Row="3" Grid.Column="1" Width="54" HorizontalAlignment="Left" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="※按设定次数从首页翻到末页" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox x:Name="CheckImageSizeOnMoveCheck"
                                          Content="检查图像尺寸后翻页(仅在自动跨页设置时生效)"
                                          Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="滚动">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="拖动滚动(1)移动量" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="DragScroll1TextBox" Width="48" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="pixel" VerticalAlignment="Center" Margin="4,0,20,0" />

                                    <TextBlock Text="拖动滚动(2)移动量" VerticalAlignment="Center" Foreground="#888888" Margin="0,0,8,0" />
                                    <TextBox Width="48" Text="5" IsEnabled="False" />
                                    <TextBlock Text="pixel" VerticalAlignment="Center" Foreground="#888888" Margin="4,0,0,0" />
                                </WrapPanel>

                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="键盘操作的滚动量:" VerticalAlignment="Center" Width="210" />
                                    <TextBlock Text="水平(横)" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox x:Name="KeyScrollXTextBox" Width="48" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="垂直(纵)" VerticalAlignment="Center" Margin="14,0,4,0" />
                                    <TextBox x:Name="KeyScrollYTextBox" Width="48" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                </WrapPanel>

                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="鼠标滚轮的滚动量:" VerticalAlignment="Center" Width="210" />
                                    <TextBlock Text="水平(横)" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox x:Name="WheelScrollXTextBox" Width="48" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="垂直(纵)" VerticalAlignment="Center" Margin="14,0,4,0" />
                                    <TextBox x:Name="WheelScrollYTextBox" Width="48" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                </WrapPanel>

                                <WrapPanel Margin="0,4,0,4">
                                    <TextBlock Text="滚动量基准:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton x:Name="ScrollUnitWindowRadio" Content="窗口大小(%)" GroupName="ScrollUnit" Checked="SettingControl_Changed" />
                                    <RadioButton x:Name="ScrollUnitImageRadio" Content="图像大小(%)" GroupName="ScrollUnit" Checked="SettingControl_Changed" />
                                    <RadioButton x:Name="ScrollUnitPixelRadio" Content="固定值(pixel)" GroupName="ScrollUnit" Checked="SettingControl_Changed" />
                                </WrapPanel>

                                <Separator Margin="0,4" />

                                <WrapPanel IsEnabled="False" Margin="0,2">
                                    <CheckBox Content="使用平滑滚动" IsChecked="False" />
                                    <TextBlock Text="速度" VerticalAlignment="Center" Margin="12,0,4,0" />
                                    <TextBox Width="50" Text="800" />
                                    <TextBlock Text="pixel/s" VerticalAlignment="Center" Margin="4,0,12,0" />
                                    <TextBlock Text="加速度" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Width="50" Text="2000" />
                                    <TextBlock Text="pixel/s2" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </WrapPanel>

                                <WrapPanel IsEnabled="False" Margin="0,2">
                                    <TextBlock Text="滚动兼翻页顺序:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <RadioButton Content="上下优先" IsChecked="True" />
                                    <RadioButton Content="左右优先" />
                                </WrapPanel>

                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="滚轮缓冲:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox x:Name="WheelBoundaryBufferTextBox" Width="44" VerticalContentAlignment="Center" Text="2" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="格 (0-9)" VerticalAlignment="Center" Margin="4,0,12,0" />
                                    <TextBlock Text="滚到页/卷边界后需再滚动的格数；0 = 立即翻页。进入边界后的 250ms 惯性滚轮会被忽略。" VerticalAlignment="Center" Foreground="#666666" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- タブ 2: 一般設定 1 (Dialog ID: 1507)                       -->
            <!-- ========================================================= -->
            <TabItem Header="常规设置 1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="加载设置">
                            <StackPanel>
                                <StackPanel>
                                    <RadioButton x:Name="SubfolderConfirmRadio" Content="存在子文件夹时显示确认对话框" GroupName="SubfolderMode" Checked="SettingControl_Changed" />
                                    <RadioButton x:Name="SubfolderIncludeRadio" Content="同时加载子文件夹" GroupName="SubfolderMode" Checked="SettingControl_Changed" />
                                    <RadioButton x:Name="SubfolderExcludeRadio" Content="不加载子文件夹" GroupName="SubfolderMode" Checked="SettingControl_Changed" />
                                    <CheckBox x:Name="IncludeFolderArchivesCheck" Content="文件夹内压缩包也计入子文件夹" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" Margin="18,2,0,2" />
                                    <CheckBox x:Name="IncludeArchiveArchivesCheck" Content="压缩包内压缩包也计入子文件夹" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" Margin="18,2,0,4" />
                                </StackPanel>

                                <DockPanel Margin="0,4,0,4">
                                    <TextBlock Text="初始文件夹" VerticalAlignment="Center" Width="78" />
                                    <Button Content="浏览..." DockPanel.Dock="Right" Width="64" Margin="6,0,0,0" Click="BrowseInitialFolder_Click" />
                                    <TextBox x:Name="InitialFolderTextBox" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                </DockPanel>

                                <CheckBox Content="加载图像时同步到文件夹树" IsChecked="True" IsEnabled="False" />

                                <WrapPanel Margin="0,4,0,4">
                                    <RadioButton Content="从书签打开" GroupName="StartupOpenMode" IsEnabled="False" />
                                    <RadioButton x:Name="OpenFromStartRadio" Content="从开头打开" GroupName="StartupOpenMode" Checked="SettingControl_Changed" />
                                    <RadioButton Content="从标记打开" GroupName="StartupOpenMode" IsEnabled="False" />
                                    <RadioButton x:Name="OpenThumbnailRadio" Content="缩略图显示" GroupName="StartupOpenMode" Checked="SettingControl_Changed" />
                                </WrapPanel>

                                <WrapPanel IsEnabled="False" Margin="0,2,0,0">
                                    <TextBlock Text="菜单历史保留数" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Width="44" Text="5" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="跨页设置">
                            <StackPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="AddBlankFirstPageCheck"
                                              Content="为扉页在首页前添加空白页"
                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                    <CheckBox Content="为扉页在首页前添加白纸页" IsEnabled="False" />
                                </WrapPanel>
                                <CheckBox Content="在首个单页前添加白纸页(首页除外)" IsEnabled="False" />
                                <Separator Margin="0,4" />
                                <WrapPanel>
                                    <CheckBox x:Name="AutoDetectConnectedCheck"
                                              Content="启用自动拼接图像检测 (2~4 张)"
                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                    <CheckBox x:Name="SuppressConnectedPromptCheck"
                                              Content="以后检测到拼接图像不再询问"
                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="翻页特效设置" IsEnabled="False">
                            <StackPanel>
                                <WrapPanel>
                                    <RadioButton Content="翻页动画" />
                                    <RadioButton Content="同时显示" IsChecked="True" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <CheckBox Content="播放音效(page.wav)" Width="160" />
                                    <TextBlock Text="翻页速度  慢" VerticalAlignment="Center" Margin="8,0,6,0" />
                                    <Slider Width="180" Minimum="1" Maximum="10" Value="7" />
                                    <TextBlock Text="快" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="全屏设置" IsEnabled="False">
                            <WrapPanel>
                                <CheckBox Content="更改分辨率" Margin="0,0,12,0" />
                                <ComboBox Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="保持当前分辨率" />
                                </ComboBox>
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- タブ 3: 一般設定 2 (Dialog ID: 1508)                       -->
            <!-- ========================================================= -->
            <TabItem Header="常规设置 2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="放大镜设置">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,6">
                                    <RadioButton x:Name="LoupeCircleRadio" Content="圆形放大镜" GroupName="LoupeShape" Checked="SettingControl_Changed" />
                                    <RadioButton x:Name="LoupeSquareRadio" Content="方形放大镜" GroupName="LoupeShape" Checked="SettingControl_Changed" Margin="0,3,32,3" />
                                    <CheckBox x:Name="LoupeBorderCheck" Content="显示放大镜边框" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                </WrapPanel>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="放大镜半径" VerticalAlignment="Center" />
                                    <Slider x:Name="LoupeRadiusSlider" Grid.Column="1" Minimum="40" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="LoupeRadiusSlider_ValueChanged" />
                                    <TextBox x:Name="LoupeRadiusTextBox" Grid.Column="2" Margin="4,0" VerticalContentAlignment="Center" TextChanged="LoupeRadiusTextBox_TextChanged" />
                                    <TextBlock Grid.Column="3" Text="pixel" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4" Text="放大镜倍率" VerticalAlignment="Center" />
                                    <Slider x:Name="LoupeScaleSlider" Grid.Column="5" Minimum="100" Maximum="800" TickFrequency="25" VerticalAlignment="Center" ValueChanged="LoupeScaleSlider_ValueChanged" />
                                    <TextBox x:Name="LoupeScaleTextBox" Grid.Column="6" Margin="4,0" VerticalContentAlignment="Center" TextChanged="LoupeScaleTextBox_TextChanged" />
                                    <TextBlock Grid.Column="7" Text="%" VerticalAlignment="Center" />
                                </Grid>

                                <WrapPanel>
                                    <CheckBox x:Name="SuppressPopupsDuringLoupeCheck" Content="使用放大镜时抑制菜单与工具栏弹出" Margin="0,3,18,3" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                    <CheckBox x:Name="LoupeClampCheck" Content="放大镜范围不超出屏幕" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="独立窗口设置" IsEnabled="False">
                            <StackPanel>
                                <WrapPanel>
                                    <RadioButton Content="用于操作" IsChecked="True" />
                                    <RadioButton Content="用于保存" Margin="0,3,36,3" />
                                    <CheckBox Content="加载后在独立窗口中显示" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Text="最大独立窗口数" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Width="48" Text="1" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Avisynth 插件路径设置" IsEnabled="False">
                            <DockPanel>
                                <Button Content="浏览..." DockPanel.Dock="Right" Width="64" Margin="6,0,0,0" />
                                <TextBox Text="AvisynthPlugin" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="背景设置">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,4">
                                    <RadioButton Content="纯色背景" IsChecked="True" Margin="0,3,16,3" />
                                    <TextBlock Text="背景色" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border x:Name="BgColorPreviewBorder" Width="36" Height="20" BorderBrush="#666666" BorderThickness="1" Background="#808080" Margin="0,0,6,0" />
                                    <TextBox x:Name="BgColorHexTextBox" Width="70" VerticalContentAlignment="Center" Margin="0,0,6,0" TextChanged="BgColorHexTextBox_TextChanged" />
                                    <Button Content="选择颜色..." Padding="8,1" Margin="0,0,6,0" Click="ChooseBgColor_Click" />
                                    <Button Content="标准灰" Padding="6,1" Margin="0,0,4,0" Click="SetGrayBg_Click" />
                                    <Button Content="黑色" Padding="6,1" Click="SetDarkBg_Click" />
                                </WrapPanel>
                                <StackPanel IsEnabled="False">
                                    <DockPanel Margin="0,2">
                                        <RadioButton Content="使用壁纸" Width="88" />
                                        <TextBlock Text="壁纸文件位置" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="浏览..." DockPanel.Dock="Right" Width="64" Margin="6,0,0,0" />
                                        <TextBox />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="书架背景设置">
                            <WrapPanel Margin="0,2,0,4">
                                <RadioButton Content="纯色背景" IsChecked="True" Margin="0,3,16,3" />
                                <TextBlock Text="背景色" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border x:Name="BookshelfBgColorPreviewBorder" Width="36" Height="20" Background="#808080" BorderBrush="#666666" BorderThickness="1" Margin="0,0,6,0" />
                                <TextBox x:Name="BookshelfBgColorHexTextBox" Width="70" VerticalContentAlignment="Center" Margin="0,0,6,0" TextChanged="BookshelfBgColorHexTextBox_TextChanged" />
                                <Button Content="选择颜色..." Padding="8,1" Click="ChooseBookshelfBgColor_Click" />
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- タブ 4: その他設定 (Dialog ID: 1509)                       -->
            <!-- ========================================================= -->
            <TabItem Header="其他设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="显示相关">
                            <StackPanel>
                                <CheckBox x:Name="ShowScrollBarsCheck" Content="滚动条显示" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox x:Name="ShowSubfolderCaptionCheck" Content="标题中也显示子文件夹" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox x:Name="ShowOsdTextCheck" Content="加载、缩放时在视图窗口显示文本" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox x:Name="FullScreenHideCursorCheck" Content="全屏时始终隐藏光标" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox x:Name="FullScreenTopMostCheck" Content="全屏时将窗口置顶" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox Content="全屏时不覆盖任务栏区域" IsEnabled="False" />
                                <CheckBox Content="拖动页码条时实时显示图像" IsEnabled="False" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="行为相关">
                            <StackPanel>
                                <CheckBox Content="启用历史列表" IsChecked="True" IsEnabled="False" />
                                <CheckBox Content="文件夹内无可用文件时显示封面缩略图" IsChecked="True" IsEnabled="False" />
                                <CheckBox Content="加载 URL 时显示「打开 URL」对话框" IsEnabled="False" />
                                <CheckBox Content="在页面编辑中实际删除标记为删除的文件(仅对非压缩包文件夹有效)" IsEnabled="False" />
                                <CheckBox x:Name="OpenLastFileCheck" Content="启动时自动打开上次打开的文件" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox Content="直接删除路径失效的列表项" IsEnabled="False" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="系统相关">
                            <StackPanel>
                                <CheckBox x:Name="SaveWindowPlacementCheck" Content="退出时保存窗口位置和大小" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox x:Name="PreventMultipleInstancesCheck" Content="禁止多开" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                <CheckBox Content="钩取鼠标消息" IsChecked="True" IsEnabled="False" />
                                <CheckBox Content="监视当前文件夹" IsEnabled="False" />
                                <CheckBox Content="阻止屏保与显示器休眠" IsEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- タブ 5: キャッシュ設定 (Dialog ID: 1510)                   -->
            <!-- ========================================================= -->
            <TabItem Header="缓存设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="常规">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="解码缓存数" Width="125" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxCachedBitmapTextBox" Width="56" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="(未压缩位图数据的保留数)" Foreground="#555555" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </WrapPanel>
                                <WrapPanel Margin="0,2,0,4" IsEnabled="False">
                                    <TextBlock Text="文件缓存大小" Width="125" VerticalAlignment="Center" />
                                    <TextBox x:Name="FileCacheSizeTextBox" Width="56" Text="512" />
                                    <TextBlock Text="MB  (文件数据；压缩包为解压后数据的保留大小)" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </WrapPanel>
                                <WrapPanel Margin="0,2,0,0">
                                    <CheckBox x:Name="ResizeCacheCheck" Content="启用缩放缓存" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                    <TextBlock Text="※启用预加载时会在预加载阶段一并执行缩放处理" Foreground="#555555" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="预加载设置">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="预加载数(前进方向)" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="PreloadForwardTextBox" Width="52" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="预加载数(后退方向)" VerticalAlignment="Center" Margin="28,0,8,0" />
                                    <TextBox x:Name="PreloadBackwardTextBox" Width="52" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                </WrapPanel>
                                <TextBlock Text="※默认预加载 4 张，设为 4 张以上时自动拼接图像检测才会生效"
                                           Foreground="#335588"
                                           FontSize="11.5"
                                           Margin="0,0,0,6" />
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="文件缓存预加载比例" Width="155" VerticalAlignment="Center" />
                                    <TextBox x:Name="PreloadRatioTextBox" Width="52" Text="75" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </WrapPanel>
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBlock Text="预加载线程优先级   低" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="PreloadPrioritySlider" Width="140" Minimum="0" Maximum="4" Value="2"
                                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="PreloadPrioritySlider_ValueChanged" />
                                    <TextBlock Text="高" VerticalAlignment="Center" Margin="8,0,8,0" />
                                    <TextBlock x:Name="PreloadPriorityLabel" Text="(普通)" Foreground="#335588" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="垃圾回收设置">
                            <StackPanel>
                                <WrapPanel Margin="0,2,0,6">
                                    <TextBlock Text="缓存容量上限" Width="115" VerticalAlignment="Center" />
                                    <TextBox x:Name="CacheMemoryLimitTextBox" Width="64" VerticalContentAlignment="Center" TextChanged="SettingControl_Changed" />
                                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </WrapPanel>
                                <TextBlock Text="※清理多余缓存以免超出容量上限" Foreground="#555555" FontSize="11.5" Margin="0,1" />
                                <TextBlock Text="※设为 0MB 时内存管理功能不生效" Foreground="#555555" FontSize="11.5" Margin="0,1" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- タブ 6: ローダ設定 (Dialog ID: 1511 - Phase 3以降で有効化) -->
            <!-- ========================================================= -->
            <TabItem Header="加载器设置">
                <StackPanel IsEnabled="False">
                    <GroupBox Header="压缩包加载设置(arc.dll)">
                        <StackPanel>
                            <CheckBox Content="不缓存固实压缩包      ※未勾选时解压后的文件会逐个缓存" />
                            <CheckBox Content="按文件批量加载 ※通过网络访问时可提升解压速度" IsChecked="True" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="JPEG 加载设置(jpg.dll)">
                        <StackPanel>
                            <CheckBox Content="直接以 YCbCr 格式输出(不做 RGB 转换与升采样)" />
                            <CheckBox Content="强制灰度转换(仅输出 Y 分量)" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="PDF 加载设置(pdf.dll)">
                        <CheckBox Content="仅加载图像资源(按图像资源而非按页)" />
                    </GroupBox>

                    <GroupBox Header="Susie 插件设置">
                        <StackPanel>
                            <RadioButton Content="禁用 Susie 插件" />
                            <RadioButton Content="使用 Susie 插件(优先标准加载器)" />
                            <RadioButton Content="使用 Susie 插件(优先 Susie 插件)" IsChecked="True" />
                            <RadioButton Content="仅使用 Susie 插件(不使用标准加载器)" />
                            <DockPanel Margin="0,6,0,4">
                                <TextBlock Text="插件路径" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="浏览..." DockPanel.Dock="Right" Width="64" Margin="6,0,0,0" />
                                <TextBox Text="SusiePlugin" />
                            </DockPanel>
                            <Button Content="插件设置..." Width="120" HorizontalAlignment="Left" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ========================================================= -->
            <!-- タブ 7: テキスト表示設定 (Dialog ID: 2600 - 未実装グレー)  -->
            <!-- ========================================================= -->
            <TabItem Header="文本显示设置">
                <StackPanel IsEnabled="False">
                    <GroupBox Header="文字方向(D)">
                        <WrapPanel>
                            <RadioButton Content="横排" IsChecked="True" Width="120" />
                            <RadioButton Content="竖排" />
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="字体(F)">
                        <StackPanel>
                            <WrapPanel Margin="0,2,0,4">
                                <TextBlock Text="字符集(S)" Width="80" VerticalAlignment="Center" />
                                <ComboBox Width="150" SelectedIndex="0">
                                    <ComboBoxItem Content="日语" />
                                </ComboBox>
                                <RadioButton Content="等宽字体(D)" Margin="12,3,8,3" />
                                <RadioButton Content="比例字体(P)" IsChecked="True" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,4">
                                <TextBlock Text="字体名(F)" Width="80" VerticalAlignment="Center" />
                                <ComboBox Width="220" SelectedIndex="0">
                                    <ComboBoxItem Content="微软雅黑" />
                                </ComboBox>
                            </WrapPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="示例(A)" Width="80" VerticalAlignment="Center" />
                                <TextBox Text="abcdABCD1234１２３４简体中文示例文字" FontSize="14" Padding="4" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="布局(L)">
                        <StackPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="文字高度(H)" Width="90" VerticalAlignment="Center" />
                                <TextBox Width="48" Text="18" />
                                <TextBlock Text="pixel" VerticalAlignment="Center" Margin="4,0,24,0" />
                                <TextBlock Text="字间距(W)" Width="80" VerticalAlignment="Center" />
                                <TextBox Width="48" Text="0" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="上边距(U)" Width="90" VerticalAlignment="Center" />
                                <TextBox Width="48" Text="10" />
                                <TextBlock Text="pixel" VerticalAlignment="Center" Margin="4,0,24,0" />
                                <TextBlock Text="下边距(D)" Width="80" VerticalAlignment="Center" />
                                <TextBox Width="48" Text="10" />
                                <TextBlock Text="pixel" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="颜色">
                        <WrapPanel>
                            <TextBlock Text="文字颜色" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Width="44" Height="18" Background="Black" BorderBrush="Gray" BorderThickness="1" Margin="0,0,24,0" />
                            <TextBlock Text="背景色" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Width="44" Height="18" Background="#FFFF80" BorderBrush="Gray" BorderThickness="1" />
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 下部 OK / キャンセル / 適用(A) ボタン -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Width="86"
                    Height="26"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="取消"
                    Width="86"
                    Height="26"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button x:Name="ApplyButton"
                    Content="应用(_A)"
                    Width="86"
                    Height="26"
                    IsEnabled="False"
                    Click="ApplyButton_Click" />
        </StackPanel>
    </Grid>
</Window>
