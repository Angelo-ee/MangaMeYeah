<Window x:Class="MangaMeYeah.QuickSaveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速保存设置"
        Width="560"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="设置快速保存 1~4 的目标文件夹和选项（支持右键拖动 ↖ ↗ ↙ ↘ 手势）。"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="1">
            <!-- Slot 1 -->
            <GroupBox Header="快速保存 1  (手势: ↑← 左上)" Margin="0,0,0,6" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Folder1TextBox" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="浏览..." Width="64" Margin="0,0,8,0" Click="Browse1_Click" />
                    <CheckBox x:Name="Prefix1CheckBox" Grid.Column="2" Content="添加父文件夹名" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>

            <!-- Slot 2 -->
            <GroupBox Header="快速保存 2  (手势: ↑→ 右上)" Margin="0,0,0,6" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Folder2TextBox" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="浏览..." Width="64" Margin="0,0,8,0" Click="Browse2_Click" />
                    <CheckBox x:Name="Prefix2CheckBox" Grid.Column="2" Content="添加父文件夹名" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>

            <!-- Slot 3 -->
            <GroupBox Header="快速保存 3  (手势: ↓← 左下)" Margin="0,0,0,6" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Folder3TextBox" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="浏览..." Width="64" Margin="0,0,8,0" Click="Browse3_Click" />
                    <CheckBox x:Name="Prefix3CheckBox" Grid.Column="2" Content="添加父文件夹名" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>

            <!-- Slot 4 -->
            <GroupBox Header="快速保存 4  (手势: ↓→ 右下)" Margin="0,0,0,6" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Folder4TextBox" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="浏览..." Width="64" Margin="0,0,8,0" Click="Browse4_Click" />
                    <CheckBox x:Name="Prefix4CheckBox" Grid.Column="2" Content="添加父文件夹名" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Height="26" IsDefault="True" Margin="0,0,8,0" Click="OkButton_Click" />
            <Button Content="取消" Width="80" Height="26" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
