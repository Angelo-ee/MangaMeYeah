<Window x:Class="MangaMeYeah.ConnectedImagePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拼接图像检测"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="MessageTextBlock"
                   Text="检测到拼接图像。是否切换为拼接显示？"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <CheckBox x:Name="SuppressPromptCheckBox"
                  Content="以后检测到拼接图像不再询问"
                  Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="显示(_Y)"
                    Width="105"
                    Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="YesButton_Click" />
            <Button Content="不显示(_N)"
                    Width="105"
                    Height="28"
                    IsCancel="True"
                    Click="NoButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
